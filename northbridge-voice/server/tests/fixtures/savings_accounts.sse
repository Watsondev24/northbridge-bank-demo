data: {"id": "1792600000000-104", "object": "thread.message.completed", "thread_id": "00000000-0000-4000-8000-000000000001", "run_id": "00000000-0000-4000-8000-000000000002", "model": "groq/openai/gpt-oss-120b", "created": 1792600000, "trace_id": "00000000000000000000000000000000", "data": {"message": {"role": "assistant", "content": [{"response_type": "text", "id": "00000000-0000-4000-8000-000000000004", "text": "Sure thing! Here’s a quick rundown of Northbridge’s savings accounts:\n\n- **Easy Access Saver** – a variable rate, and you can take money out whenever you like.  \n- **Fixed Rate Saver** – a fixed rate for one or two years, in return for leaving the money untouched.  \n- **Cash ISA** – interest paid tax-free, up to your yearly ISA allowance.  \n\nYou can open any of them in the Northbridge app in a few minutes. Is there a particular account you’d like details on?"}]}}, "choices": [{"message": {"role": "assistant", "content": "Sure thing! Here’s a quick rundown of Northbridge’s savings accounts:\n\n- **Easy Access Saver** – a variable rate, and you can take money out whenever you like.  \n- **Fixed Rate Saver** – a fixed rate for one or two years, in return for leaving the money untouched.  \n- **Cash ISA** – interest paid tax-free, up to your yearly ISA allowance.  \n\nYou can open any of them in the Northbridge app in a few minutes. Is there a particular account you’d like details on?"}}]}

