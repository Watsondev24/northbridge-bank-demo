# Copy to .env and fill in. Never commit .env.

# ── watsonx Orchestrate ──────────────────────────────────────────────
# Settings → API details in watsonx Orchestrate, e.g.
# https://api.eu-gb.watson-orchestrate.cloud.ibm.com/instances/<your-instance-id>
WXO_INSTANCE_URL=
# The Northbridge Bank Agent's ID
WXO_AGENT_ID=
# Settings → API details → Generate API key
WXO_API_KEY=

# ── ElevenLabs ───────────────────────────────────────────────────────
# elevenlabs.io → Developers → API keys
ELEVENLABS_API_KEY=
# Printed the first time you run `python server/create_engine.py <your ngrok URL>`.
# Leave blank until then.
ELEVENLABS_SPEECH_ENGINE_ID=
# Optional: the agent's voice (Voice Library → copy voice ID). Applied by create_engine.py.
ELEVENLABS_VOICE_ID=

# ── Optional ─────────────────────────────────────────────────────────
# Lines played while wxO searches, separated by |. Cues in [brackets] are
# acted out by the voice.
#FILLERS=[thoughtfully] Hm...|[softly] Uh, let's see...|[quietly] Mm...
# Asked before a personal borrowing estimate, which goes to the slower
# Mortgage Agent. Hold music plays if the caller says yes. Empty turns it off.
#SPECIALIST_ASK=That one might take a little longer to check, is that okay?
# How soon ElevenLabs decides the caller has finished: patient | normal | eager.
# Applied by create_engine.py.
#TURN_EAGERNESS=normal
