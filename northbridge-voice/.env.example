# Copy to .env and fill in. Never commit .env.

# ── watsonx Orchestrate ──────────────────────────────────────────────
# Settings → API details in watsonx Orchestrate, e.g.
# https://api.eu-gb.watson-orchestrate.cloud.ibm.com/instances/<your-instance-id>
WXO_INSTANCE_URL=
# Your main agent's ID (the Northbridge Bank Agent)
WXO_AGENT_ID=
# Settings → API details → Generate API key
WXO_API_KEY=
# The tool-free agent that writes everything said while the main agent works.
# Leave empty (or comment out) to use a plain "Mm-hmm." instead.
WXO_FILLER_AGENT_ID=

# ── ElevenLabs ───────────────────────────────────────────────────────
# elevenlabs.io → Developers → API keys
ELEVENLABS_API_KEY=
# Printed by `python server/create_engine.py <your public URL>`; leave blank until then
ELEVENLABS_SPEECH_ENGINE_ID=
# Optional: voice for the agent (Voice Library → copy voice ID). Used by create_engine.py
ELEVENLABS_VOICE_ID=
# Voice model, applied by create_engine.py
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ENGINE_LANGUAGE=en
# How soon ElevenLabs decides the caller has finished: patient | normal | eager.
# Eager replies sooner but can cut in on people who pause mid-sentence.
# Applied by create_engine.py.
TURN_EAGERNESS=normal

# ── Behaviour ────────────────────────────────────────────────────────
# Speak while the main agent works: the filler agent's lines, or "Mm-hmm."
# without one (false = stay quiet until the answer)
QUICK_FILLER=true
# Without a filler agent, two tiers of hard-coded lines, each used in order and
# starting again from the first. Separate with |. [brackets] are delivery cues
# acted out by v3/v4 voices (removed for other models).
# Leave these out to use the built-in lists.
#
# Said when wxO starts searching, or if nothing has come back after
# ACKNOWLEDGE_AFTER seconds. Answers that need no search get nothing.
#FILLERS=[thoughtfully] Hm...|[softly] Uh, let's see...|[quietly] Mm...
ACKNOWLEDGE_AFTER=1.5
# ...or after this many seconds for questions that look like they'll need a
# search, without waiting for wxO to decide. 0 turns this off.
EARLY_FILLER_AFTER=0.7
# One quieter line if the answer still hasn't started this many seconds after
# the filler finishes. 0 turns it off.
#STILL_THINKING=[whispers] Mm-hmm... just checking...|[quietly] Erm, bear with me...
STILL_THINKING_AFTER=2.5
# For questions that go to the slower Mortgage Affordability Agent: ask whether
# the caller minds waiting, then play hold music (client/public/hold-music.mp3)
# on their go-ahead until the answer is ready. Empty SPECIALIST_ASK turns it off.
#SPECIALIST_ASK=That one might take a little longer to check, is that okay?
#SPECIALIST_DECLINED=No problem. Is there anything else I can help with?
# Asked when wxO routes to a tool or agent whose name matches this pattern
#SPECIALIST_TOOLS=mortgage|affordab

# Conversation tokens one IP address can request per minute
TOKENS_PER_MINUTE=12

DEBUG=false
# Skips the ElevenLabs signature check on /ws. Local testing only, never in Code Engine.
DISABLE_AUTH=false
